APP_NAME=Ordarat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For Neon Postgres (production) use DB_CONNECTION=pgsql with the pooled
# connection details from your Neon project dashboard, for example:
# DB_CONNECTION=pgsql
# DB_HOST=ep-xxxx-pooler.eu-central-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=ordarat
# DB_USERNAME=ordarat_owner
# DB_PASSWORD=your-neon-password
# DB_SSLMODE=require
# For MySQL / local PostgreSQL:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ordarat
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk used for merchant-uploaded store/product images.
# Keep "public" locally; set to "neon" after Neon Object Storage is configured.
UPLOADS_DISK=public
QUEUE_CONNECTION=database

# Neon Object Storage (S3-compatible) - fill from the Neon console, then
# set UPLOADS_DISK=neon. See docs/NEON_SETUP.md
# NEON_ACCESS_KEY_ID=
# NEON_SECRET_ACCESS_KEY=
# NEON_REGION=eu-central-1
# NEON_BUCKET=
# NEON_ENDPOINT=
# NEON_PUBLIC_URL=
# NEON_USE_PATH_STYLE_ENDPOINT=false

CACHE_STORE=database
CACHE_PREFIX=

# Firebase Auth Configuration (For client ID token verification)
FIREBASE_PROJECT_ID=ordarat-qena

# Ordarat Platform Configuration
ORDARAT_CITY="قنا"
ORDARAT_CITY_SLUG="qena"
SUBSCRIPTION_CONTACT_NUMBER="+201055370118"
SUBSCRIPTION_WHATSAPP_NUMBER="+201055370118"
UNACCEPTED_ORDER_ALERT_MINUTES=10
ORDER_RATE_LIMIT_PER_MINUTE=5
MAX_IMAGE_UPLOAD_MB=4

# Demo seeding (local development / disposable demo environments ONLY).
# The database seeder creates demo users with a known password and sample
# data. It is skipped automatically when APP_ENV=production unless this is
# explicitly enabled. Never enable it on a real deployment.
# SEED_DEMO_DATA=false
# SEED_DEMO_PASSWORD=change-me
