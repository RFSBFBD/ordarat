APP_NAME=Ordarat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For MySQL / PostgreSQL:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ordarat
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Firebase Auth Configuration (For client ID token verification)
FIREBASE_PROJECT_ID=ordarat-qena

# Ordarat Platform Configuration
ORDARAT_CITY="قنا"
ORDARAT_CITY_SLUG="qena"
SUBSCRIPTION_CONTACT_NUMBER=""
SUBSCRIPTION_WHATSAPP_NUMBER=""
UNACCEPTED_ORDER_ALERT_MINUTES=10
ORDER_RATE_LIMIT_PER_MINUTE=5
MAX_IMAGE_UPLOAD_MB=4
